rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // IMPORTANT: Since this application uses a custom authentication system 
    // (checking usernames/passwords stored in documents) instead of Firebase Authentication,
    // we cannot use `request.auth != null`. 
    // For now, these rules allow public read/write access to all necessary collections
    // so that the app functions correctly for both Admins and Cell Leaders.
    
    match /admins/{document} {
      allow read, write: if true;
    }
    
    match /cellleaders/{document} {
      allow read, write: if true;
    }
    
    match /students/{document} {
      allow read, write: if true;
    }
    
    match /attendance/{document} {
      allow read, write: if true;
    }
    
    match /leader_attendance/{document} {
      allow read, write: if true;
    }
    
    match /reports/{document} {
      allow read, write: if true;
    }
    
    match /prayer_requests/{document} {
      allow read, write: if true;
    }
    
    match /meeting_places/{document} {
      allow read, write: if true;
    }
    
    match /deleted_members/{document} {
      allow read, write: if true;
    }
    
    match /settings/{document} {
      allow read, write: if true;
    }
    
    // Default deny for any unknown collections to prevent accidental data leaks
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
