rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -- CELL LEADER & ADMIN DATA --
    match /cellleaders/{document} {
      allow read, write: if true;
    }
    match /admins/{document} {
      allow read, write: if true;
    }
    
    // -- MEMBERS & ATTENDANCE --
    match /students/{document} {
      allow read, write: if true;
    }
    match /attendance/{document} {
      allow read, write: if true;
    }
    match /memberAttendance/{document} {
      allow read, write: if true;
    }
    match /leaderAttendance/{document} {
      allow read, write: if true;
    }
    match /leader_attendance/{document} {
      allow read, write: if true;
    }
    
    // -- REPORTS & PRAYER REQUESTS --
    match /reports/{document} {
      allow read, write: if true;
    }
    match /prayer_requests/{document} {
      allow read, write: if true;
    }
    
    // -- APP FEATURES --
    match /meeting_places/{document} {
      allow read, write: if true;
    }
    match /announcements/{document} {
      allow read, write: if true;
    }
    match /approvals/{document} {
      allow read, write: if true;
    }
    
    // Catch-all
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}
